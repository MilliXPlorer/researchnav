# Include inside Nginx's http context after adapting listener/certificate paths.
# The certificate must cover both the apex and www hostnames.
server {
    listen 80;
    listen [::]:80;
    server_name researchnavph.tech www.researchnavph.tech;

    return 308 https://researchnavph.tech$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.researchnavph.tech;

    ssl_certificate /etc/letsencrypt/live/researchnavph.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/researchnavph.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 308 https://researchnavph.tech$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name researchnavph.tech;

    ssl_certificate /etc/letsencrypt/live/researchnavph.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/researchnavph.tech/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Accommodate the existing 100 MiB gateway upload limit and worker timeouts.
    client_max_body_size 105m;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }
}
