# Browser-safe frontend configuration
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# SSR server and local development
DEV_API_PROXY_TARGET=http://127.0.0.1:3001
DEV_ALLOWED_ORIGINS=
SSR_API_ORIGIN=http://127.0.0.1:3001
# Keep normal API requests responsive; manuscript uploads use their own timeout.
SSR_API_TIMEOUT_MS=5000
SSR_CONTENT_UPLOAD_TIMEOUT_MS=120000
SSR_MAX_BODY_BYTES=28311552
PUBLIC_ORIGIN=https://researchnav.example.edu
HOST=127.0.0.1
PORT=5173
