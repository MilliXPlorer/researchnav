APP_NAME=ResearchNAV
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:3001
FRONTEND_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=researchnav_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=researchnav_sid
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt
BOOTSTRAP_ADMIN_EMAIL=

# Optional supporting context for similarity checks. The model stays outside
# request/database/private-document storage and is never exposed.
# Use forward slashes in both paths: dotenv treats a backslash inside a
# double-quoted value as an escape sequence and rejects the file.
# The worker reloads the model on every request, and a cold load of
# cc.en.300.bin measured 17.7 s, so raise the timeout to 60 when FastText is
# configured. Leave the model path empty to run the authoritative weighted
# TF-IDF/cosine checks with null FastText support on every endpoint.
SIMILARITY_PYTHON_BINARY=python
SIMILARITY_FASTTEXT_MODEL_PATH=
SIMILARITY_TIMEOUT_SECONDS=20
SIMILARITY_MAXIMUM_CANDIDATES=1000
SIMILARITY_PHP_MEMORY_LIMIT=512M
SIMILARITY_MAXIMUM_INPUT_BYTES=268435456
SIMILARITY_MAXIMUM_OUTPUT_BYTES=2097152

# Private manuscript projection worker. Its only input is a PHP-verified local
# path; its stdout is a strict JSON protocol and it receives no app secrets.
MANUSCRIPT_SEARCH_PYTHON_BINARY=python
MANUSCRIPT_SEARCH_CLI_PATH=
MANUSCRIPT_SEARCH_TIMEOUT_SECONDS=30
MANUSCRIPT_SEARCH_MAXIMUM_INPUT_BYTES=26214400
MANUSCRIPT_SEARCH_MAXIMUM_OUTPUT_BYTES=8388608
MANUSCRIPT_SEARCH_MAXIMUM_TEXT_CHARACTERS=1000000
MANUSCRIPT_SEARCH_PART_CHARACTERS=100000
MANUSCRIPT_SEARCH_EXTRACTOR_VERSION=manuscript-text/1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

VITE_APP_NAME="${APP_NAME}"
