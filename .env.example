# Google Identity Services Web Client ID (the same value is used by web and API)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# PostgreSQL and session security
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchnav
DATABASE_SSL=false
DATABASE_CA=
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=
TRUST_PROXY_HOPS=1
API_PORT=3001
APP_URL=http://localhost:5173, https://80fd-2001-4455-6b1-6b00-24d0-90e8-49e7-f3df.ngrok-free.app
APP_ORIGINS=
NODE_ENV=development

# Optional SMTP delivery for account invitation notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ResearchNAV <no-reply@example.edu>
